# Dummy values for test runs — never real secrets, safe to commit.
# Loaded by tests/conftest.py before any app module (and its real .env-backed
# API keys) can be imported, so tests can never accidentally hit real
# Gemini/Mistral/educore APIs and burn real tokens.
GEMINI_API_KEY=test-gemini-key
MISTRAL_API_KEY=test-mistral-key
EDUCORE_HOST=http://educore.test
EDUCORE_API_KEY=test-educore-key
